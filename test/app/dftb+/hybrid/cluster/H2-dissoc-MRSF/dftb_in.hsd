Geometry = GenFormat {
  <<< "geo.gen"
}

Driver = {}

Hamiltonian = DFTB {

  SCC = Yes
  SCCTolerance = 1e-9

  MaxAngularMomentum = {
    H = "s"
  }

  SlaterKosterFiles = Type2FileNames {
    Prefix = "slakos/origin/ob2-1-1/shift/"
    Separator = "-"
    Suffix = ".skf"
  }

  SpinPolarisation = Colinear {
    UnpairedElectrons = 2
  }

  Filling = Fermi {Temperature [K] = 0.0}

  RangeSeparated = LC {
    Screening = MatrixBased {}
  }

  SpinConstants = {
    H = {-0.072}
  }

}

# Dissociating H2: the high-spin triplet (3 Sigma_u+) is the reference and the
# lowest MRSF singlet is the ground state. At this stretched geometry the
# singlet-triplet gap must vanish (two independent H atoms), i.e. the lowest
# MRSF singlet excitation energy -> 0 - a stringent multireference test.
ExcitedState {
  SpinFlip {
    NrOfExcitations = 3
    StateOfInterest = 1
    MixedReference = Yes
    Multiplicity = Singlet
    SpinComplete = Yes
  }
}

ParserOptions {
  ParserVersion = 10
}

Options {
  WriteAutotestTag = Yes
}
