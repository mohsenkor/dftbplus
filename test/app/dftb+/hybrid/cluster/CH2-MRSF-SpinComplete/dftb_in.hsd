Geometry = GenFormat {
  <<< "geo.gen"
}

Driver = {}

Hamiltonian = DFTB {

  SCC = Yes
  SCCTolerance = 1e-8

  MaxAngularMomentum = {
    C = "p"
    H = "s"
  }

  SlaterKosterFiles = Type2FileNames {
    Prefix = "slakos/origin/ob2-1-1/shift/"
    Separator = "-"
    Suffix = ".skf"
  }

  SpinPolarisation = Colinear {
    UnpairedElectrons = 2
  }

  Filling = Fermi {Temperature [K] = 0.0}

  RangeSeparated = LC {
    Screening = MatrixBased {}
  }

  SpinConstants = {
    C = {-0.023}
    H = {-0.072}
  }

}

# Spin-complete mixed-reference spin-flip (MRSF-TDDFT): the single-SOMO blocks are augmented
# with their M_S=-1 partner configurations, purifying the closed->SOMO / SOMO->virtual states.
ExcitedState {
  SpinFlip {
    NrOfExcitations = 6
    StateOfInterest = 1
    MixedReference = Yes
    Multiplicity = Singlet
    SpinComplete = Yes
  }
}

ParserOptions {
  ParserVersion = 10
}

Options {
  WriteAutotestTag = Yes
}
