Geometry = GenFormat {
  <<< "geo.gen"
}

Driver = {}

Hamiltonian = DFTB {

  SCC = Yes
  SCCTolerance = 1e-8

  Charge = 2

  MaxAngularMomentum = {
    C = "p"
    H = "s"
  }

  SlaterKosterFiles = Type2FileNames {
    Prefix = "slakos/origin/ob2-1-1/shift/"
    Separator = "-"
    Suffix = ".skf"
  }

  SpinPolarisation = Colinear {
    UnpairedElectrons = 2
  }

  Filling = Fermi {Temperature [K] = 0.0}

  RangeSeparated = LC {
    Screening = MatrixBased {}
  }

  SpinConstants = {
    C = {-0.023} # HOMO Wpp
    H = {-0.072} # HOMO Wss
  }

}

# Collinear spin-flip excitations (SF-TDDFT) on the high-spin (M_S = +1) reference.
# The spin-flip manifold (alpha-occupied -> beta-virtual) is solved within the TDA, with
# the off-diagonal coupling carried entirely by the LC-DFTB long-range exact exchange.
ExcitedState {
  SpinFlip {
    NrOfExcitations = 10
    StateOfInterest = 1
  }
}

ParserOptions {
  ParserVersion = 10
}

Options {
  WriteAutotestTag = Yes
}
